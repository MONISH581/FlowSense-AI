# FlowSense AI Backend Configuration Example
HOST=127.0.0.1
PORT=8000

# SQLite default or PostgreSQL URL (e.g., postgresql://user:password@localhost:5432/flowsense)
DATABASE_URL=sqlite:///./flowsense.db

# JWT Security
JWT_SECRET_KEY=flowsense_super_secure_production_secret_key_change_me_99
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

